COMPOSE_PROJECT_NAME=newswebsite
ENVIRONMENT=production
APP_NAME="IELTSTask Newsroom"
APP_DOMAIN=news.ieltstask.com
TLS_EMAIL=puttisainaveen@gmail.com
ALLOWED_HOSTS=news.ieltstask.com,localhost,127.0.0.1
COOKIE_SECURE=true

DB_NAME=newswebsite
DB_USER=newswebsite
DB_PASSWORD=replace-with-a-random-password-of-at-least-16-characters

ADMIN_USERNAME=sainaveennews
ADMIN_PASSWORD=replace-with-a-private-admin-password
SESSION_SECRET=replace-with-at-least-32-random-characters

PAGE_SIZE=12
MAX_IMPORT_URLS=50
FETCH_CONCURRENCY=5
FETCH_TIMEOUT_SECONDS=12
FETCH_MAX_BYTES=2097152
BACKUP_ROOT=./backups
BACKUP_RETENTION_DAYS=14
